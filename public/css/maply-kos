/* ==========================================================================
   MAPLY — Desain ulang halaman Cari Kos (gaya kartu ala GoFood)
   File tambahan: dimuat HANYA oleh resources/views/kos/index.blade.php.
   Semua aturan diawali body.page-kos / .kos-page, jadi halaman lain
   (Beranda, detail kos, admin) tidak terpengaruh. maply.css tidak diubah.
   Warna memakai variabel tema yang sudah ada (mode gelap & terang ikut jalan).
   ========================================================================== */

/* ---------- Header ---------- */
.kos-page { padding-bottom: 48px; }
.kos-hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 6px 0 4px; }
.kos-hero h1 { font-size: clamp(26px, 3.6vw, 36px); letter-spacing: -.02em; line-height: 1.15; }
.kos-hero__note { margin-top: 6px; font-size: 13px; color: var(--warn); }
.kos-loc {
  display: inline-flex; align-items: center; gap: 8px;
  margin-top: 10px; padding: 8px 14px;
  border-radius: 999px; border: 1px solid var(--border);
  background: var(--card); color: var(--text);
  font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
  max-width: 100%;
  transition: border-color .18s, background .18s, transform .18s;
}
.kos-loc:hover { border-color: var(--neon); background: var(--card-elev); transform: translateY(-1px); }
.kos-loc > i:first-child { color: var(--neon); }
.kos-loc span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.kos-loc__arrow { font-size: 11px; color: var(--muted-deep); }

/* ---------- Bar pencarian ---------- */
.kos-searchbar { display: flex; align-items: center; gap: 10px; margin: 18px 0 12px; }
.kos-search { flex: 1; min-width: 0; }
body.page-kos .kos-search .input {
  height: 54px; border-radius: 999px; padding-left: 48px; font-size: 15.5px;
  background: var(--card); border-color: var(--border);
  box-shadow: var(--shadow-sm);
}
body.page-kos .kos-search > i { left: 19px; font-size: 16px; color: var(--neon); }
.kos-searchbar .btn { height: 54px; border-radius: 999px; padding: 0 24px; }
.kos-filter-btn { position: relative; gap: 9px; background: var(--card); }
.kos-filter-btn i { color: var(--neon); }
.kos-filter-btn__count {
  min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px;
  display: inline-grid; place-items: center;
  background: var(--grad-brand); color: #fff; font-size: 12px; font-weight: 700;
}

/* ---------- Chip cepat ---------- */
.kos-rail {
  display: flex; align-items: center; gap: 8px;
  overflow-x: auto; padding: 4px 2px 12px; margin-bottom: 4px;
  scrollbar-width: none; -webkit-overflow-scrolling: touch;
}
.kos-rail::-webkit-scrollbar { display: none; }
.kos-rail__sep { flex: none; width: 1px; height: 26px; background: var(--border); margin: 0 6px; }
.kchip { position: relative; flex: none; cursor: pointer; }
.kchip input { position: absolute; opacity: 0; pointer-events: none; }
.kchip span {
  display: inline-flex; align-items: center;
  padding: 9px 17px; border-radius: 999px;
  border: 1px solid var(--border); background: var(--card);
  color: var(--text); font-size: 14px; font-weight: 600; white-space: nowrap;
  transition: background .16s, border-color .16s, color .16s, transform .16s, box-shadow .16s;
}
.kchip:hover span { border-color: var(--neon); transform: translateY(-1px); }
.kchip input:checked + span {
  background: var(--grad-brand); border-color: transparent; color: #fff;
  box-shadow: 0 6px 16px rgba(139, 61, 255, .32);
}
.kchip input:focus-visible + span { outline: 2px solid var(--neon); outline-offset: 2px; }
.kchip--sm span { padding: 7px 13px; font-size: 13.5px; font-weight: 500; }
.kos-chipset { display: flex; flex-wrap: wrap; gap: 8px; }

/* ---------- Peta ---------- */
body.page-kos .map-card { border-radius: 24px; border: 1px solid var(--border-soft); box-shadow: var(--shadow-sm); overflow: hidden; margin-top: 4px; }
.kos-map__stage { position: relative; }
body.page-kos .map-box { height: clamp(300px, 44vh, 440px); }
.kos-map__actions { position: absolute; top: 12px; right: 12px; z-index: 5; display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.kos-map__btn {
  min-height: 38px; padding: 7px 14px; border-radius: 999px;
  background: var(--card); color: var(--text); border: 1px solid var(--border);
  box-shadow: 0 4px 14px rgba(10, 5, 22, .35); font-size: 13.5px;
}
.kos-map__btn i { color: var(--neon); }
.kos-map__btn:hover { border-color: var(--neon); background: var(--card-elev); }
.kos-map__legend {
  display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center;
  padding: 12px 18px; font-size: 13px; color: var(--muted);
  border-top: 1px solid var(--border-soft); background: var(--card);
}
body.page-kos .map-note { background: var(--card); color: var(--muted); border-top: 1px solid var(--border-soft); padding: 10px 18px; font-size: 13.5px; }
body.page-kos .map-note i { color: var(--neon); }
body.page-kos .map-note--warn { background: var(--warn-bg); color: var(--warn); }
body.page-kos .map-note--warn i { color: var(--warn); }

/* ---------- Judul hasil ---------- */
.kos-results { margin-top: 8px; }
body.page-kos .results-head { margin: 26px 0 18px; }
body.page-kos .results-head h2 { font-size: clamp(21px, 2.6vw, 26px); letter-spacing: -.01em; }
body.page-kos .sort-box .select { border-radius: 999px; min-width: 210px; background-color: var(--card); }

/* ---------- Kartu kos ala GoFood ---------- */
body.page-kos .kos-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px 22px; }
body.page-kos .kos-card {
  position: relative; gap: 12px;
  background: transparent; border: 0; box-shadow: none; border-radius: 0; overflow: visible;
}
body.page-kos .kos-card:hover { transform: translateY(-3px); box-shadow: none; border-color: transparent; }
body.page-kos .kos-card .photo-box {
  aspect-ratio: 4 / 3; border-radius: 22px;
  box-shadow: 0 8px 22px rgba(10, 5, 22, .28);
  transition: box-shadow .25s;
}
body.page-kos .kos-card:hover .photo-box { box-shadow: 0 14px 30px rgba(10, 5, 22, .4), 0 0 0 2px var(--neon); }
body.page-kos .kos-card .photo-box .badges { left: 12px; top: 12px; right: 12px; }
body.page-kos .kos-card .photo-box .status-badge { right: 12px; bottom: 12px; }
body.page-kos .kos-card__body { padding: 0 4px; gap: 7px; }
body.page-kos .kos-card h3 { font-size: 17px; font-weight: 700; line-height: 1.3; letter-spacing: -.005em; }
body.page-kos .kos-card h3 a::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: 22px; } /* seluruh kartu bisa diklik */
body.page-kos .kos-card .loc { font-size: 13.5px; line-height: 1.45; }
body.page-kos .kos-card .loc strong { color: var(--neon); font-weight: 700; }
body.page-kos .kos-card .chips { gap: 6px; }
body.page-kos .kos-card .chip { border-radius: 999px; padding: 3px 11px; font-size: 12px; background: var(--code-bg); border-color: transparent; }
body.page-kos .kos-card__foot { margin-top: 2px; padding-top: 6px; border-top: 0; }
body.page-kos .kos-card .price { font-size: 19px; color: var(--text); }
body.page-kos .kos-card__actions { position: relative; z-index: 2; } /* tombol tetap bisa diklik di atas link kartu */
body.page-kos .kos-card__actions .btn { min-height: 38px; border-radius: 999px; padding: 7px 16px; font-size: 13.5px; }

/* ---------- Laci filter (menggantikan panel samping) ---------- */
body.page-kos .filter-panel {
  position: fixed; top: 0; left: 0; bottom: 0; right: auto;
  width: min(430px, 100vw); max-height: none;
  z-index: 2000; display: flex; flex-direction: column; overflow: hidden;
  border: 0; border-right: 1px solid var(--border); border-radius: 0 26px 26px 0;
  box-shadow: var(--shadow);
  transform: translateX(-104%); visibility: hidden;
  transition: transform .3s cubic-bezier(.2, .8, .2, 1), visibility 0s linear .3s;
}
body.page-kos .filter-panel.open { transform: none; visibility: visible; transition-delay: 0s; }
body.page-kos .filter-panel__head { position: static; padding: 18px 22px; flex: none; }
body.page-kos .filter-panel__head h2 { font-size: 19px; }
body.page-kos .filter-panel .filter-form { display: flex; flex: 1; min-height: 0; padding: 0; gap: 0; }
.filter-form__body { flex: 1; min-height: 0; overflow-y: auto; padding: 18px 22px 24px; display: flex; flex-direction: column; gap: 20px; }
body.page-kos .filter-actions {
  flex: none; padding: 14px 22px; gap: 10px;
  border-top: 1px solid var(--border-soft); background: var(--card);
}
body.page-kos .filter-actions .btn { border-radius: 999px; min-height: 48px; }
body.page-kos .filter-actions .btn-primary { flex: 2; }
.kos-icon-btn {
  width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--border);
  background: transparent; color: var(--text); display: grid; place-items: center; cursor: pointer;
  transition: background .16s, border-color .16s;
}
.kos-icon-btn:hover { background: var(--violet-bg); border-color: var(--neon); }
.filter-backdrop {
  position: fixed; inset: 0; z-index: 1990; background: var(--backdrop);
  opacity: 0; visibility: hidden;
  transition: opacity .25s, visibility 0s linear .25s;
}
.filter-panel.open + .filter-backdrop { opacity: 1; visibility: visible; transition-delay: 0s; }
body.kos-drawer-open { overflow: hidden; }

/* ---------- Responsif ---------- */
@media (max-width: 1180px) {
  body.page-kos .kos-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  .kos-searchbar { flex-wrap: wrap; }
  .kos-search { flex-basis: 100%; }
  .kos-searchbar__go { flex: 1; }
  .kos-filter-btn { flex: 1; }
  .kos-map__actions { top: 10px; right: 10px; }
  .kos-map__btn { padding: 6px 12px; font-size: 13px; }
}
@media (max-width: 640px) {
  body.page-kos .kos-grid { grid-template-columns: 1fr; gap: 26px; }
  body.page-kos .map-box { height: 320px; }
  body.page-kos .filter-panel { border-radius: 0; }
  body.page-kos .filter-actions { padding-right: 92px; } /* beri ruang untuk tombol Moy AI di kanan bawah */
  body.page-kos .sort-box { width: 100%; }
  body.page-kos .sort-box .select { flex: 1; min-width: 0; }
}
@media (prefers-reduced-motion: reduce) {
  body.page-kos .filter-panel, .filter-backdrop { transition: none; }
}

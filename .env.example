APP_NAME=Maply
APP_ENV=local
APP_KEY=
# Setel APP_DEBUG=false dan APP_ENV=production bila dipasang di server publik.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# BAWAAN: SQLite — tanpa konfigurasi apa pun. File database/database.sqlite
# sudah disertakan dan berisi data (kos, kampus, akun demo).
DB_CONNECTION=sqlite

# Opsi A — XAMPP / MySQL (jika ingin memakai MySQL):
#   1. Buat database 'maply' di phpMyAdmin.
#   2. Beri tanda # pada baris DB_CONNECTION=sqlite di atas.
#   3. Hapus tanda # pada 5 baris di bawah, lalu jalankan SETUP-MAPLY.bat
#      (atau: php artisan migrate:fresh --seed).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maply
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Khusus Maply -------------------------------------------------------
# Password akun admin demo saat seeding (default: Admin@Maply2026). GANTI untuk server publik.
# MAPLY_ADMIN_PASSWORD=
# true = ikut memasukkan 30 data CONTOH (bukan listing nyata). Default false: hanya data hasil pengumpulan.
MAPLY_SEED_CONTOH=false

VITE_APP_NAME="${APP_NAME}"

# Kontak operator untuk layanan geocoding Nominatim (isi email yang valid)
NOMINATIM_EMAIL=

# --- AI Kost Manager ----------------------------------------------------
# Google Places API (New): aktifkan Places API (New) dan billing di Google Cloud.
GOOGLE_PLACES_API_KEY=
# Mode aman: kandidat selalu menunggu persetujuan admin.
MAPLY_AI_AUTO_PUBLISH=false
